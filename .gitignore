# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/web/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/web/coverage

# next.js
/web/.next/
/web/out/

# production
/web/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite database (regenerate via: npm run db:migrate && npm run db:seed, chạy trong thư mục web/)
*.db
*.db-journal
*.db-wal
*.db-shm
test-results/
playwright-report/
e2e-test.db*

# quarantined/local-only content the user explicitly asked not to commit
note.txt

# AI chatbot (Milestone 6/7/8, xem AI_CHATBOT_PLAN.md) — model nén và dữ liệu thô/train
# không đưa lên GitHub (quá nặng, và data/raw có thể chứa tài liệu không có quyền phát tán)
/ai/models/
/ai/data/raw/
/ai/data/processed/
*.gguf
*.safetensors
*.bin

# ai/'s Python virtualenv (python -m venv đã tự tạo .gitignore riêng bên trong
# rồi, dòng này chỉ để phòng hờ nếu venv được tạo lại bằng cách khác) + bytecode cache
/ai/.venv/
__pycache__/
*.pyc

# Milestone 7: ai/kaggle/ chứa 2 loại file, cả 2 đều không track:
# - notebook .ipynb sinh ra tự động bởi ai/training/build_*.py (chạy lại
#   script đó để tái tạo)
# - kết quả user tải về từ Kaggle sau khi chạy (generated_qa.jsonl,
#   generation_errors.json...) — dữ liệu trung gian, giống ai/data/processed/
/ai/kaggle/

# Milestone 7 §12.3: adapter LoRA đã train (giải nén từ ai/kaggle/lora_adapter.zip)
# — an toàn dùng local, nhưng không đẩy GitHub (nặng, tái tạo được bằng cách train lại)
/ai/training/output/
