# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/web/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/web/coverage

# next.js
/web/.next/
/web/out/

# production
/web/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite database (regenerate via: npm run db:migrate && npm run db:seed, chạy trong thư mục web/)
*.db
*.db-journal
*.db-wal
*.db-shm
test-results/
playwright-report/
e2e-test.db*

# quarantined/local-only content the user explicitly asked not to commit
note.txt

# AI chatbot (Milestone 6/7/8, xem AI_CHATBOT_PLAN.md) — model nén và dữ liệu thô/train
# không đưa lên GitHub (quá nặng, và data/raw có thể chứa tài liệu không có quyền phát tán)
/ai/models/
/ai/data/raw/
/ai/data/processed/
*.gguf
*.safetensors
*.bin

# ai/'s Python virtualenv (python -m venv đã tự tạo .gitignore riêng bên trong
# rồi, dòng này chỉ để phòng hờ nếu venv được tạo lại bằng cách khác) + bytecode cache
/ai/.venv/
__pycache__/
*.pyc

# Milestone 7: notebook Kaggle sinh ra tự động bởi ai/training/build_*.py
# (nhúng nội dung ai/data/processed/, cũng gitignore) — chạy lại script đó để
# tái tạo, không cần track file .ipynb. ai/kaggle/ chỉ chứa các notebook
# sinh ra kiểu này (notebook sinh dữ liệu, sau này thêm notebook train LoRA).
/ai/kaggle/*.ipynb
